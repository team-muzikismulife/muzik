# production(기본) / emulator / demo. 개발 서버도 명시적으로 선택한다.
EXPO_PUBLIC_APP_MODE=production
# 운영 웹 App Check reCAPTCHA v3 사이트 키(비밀 키 아님)
EXPO_PUBLIC_RECAPTCHA_SITE_KEY=

# Firebase 콘솔 > 프로젝트 설정 > 웹 앱에서 복사 후 .env 로 저장
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# 배포된 웹 도메인 — 초대 링크(https://<도메인>/r/{코드}) 생성용 (src/lib/invite.ts).
# 웹에서는 현재 origin을 자동으로 쓰므로 비워둬도 된다. 네이티브(앱)에서 초대 링크를
# 보내려면 채운다. 비어 있으면 초대는 6자리 코드만으로 공유된다(코드 입력 화면으로 입장).
EXPO_PUBLIC_WEB_URL=

{
  "name": "@muzik/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/check-env.mjs && tsc --noEmit && node scripts/icons.mjs && vite build && node scripts/check-bundle.mjs",
    "build:release": "node scripts/check-env.mjs --release && npm run build",
    "build:vercel": "node scripts/vercel-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:db": "tsx ../../tests/integration/supabase.test.ts",
    "test:browser": "playwright test",
    "test:hosting": "playwright test --config playwright.hosting.config.ts",
    "check:vercel": "node scripts/check-vercel-config.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "@tanstack/react-query": "5.103.2",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "pg": "8.23.0",
    "sharp": "0.35.4",
    "supabase": "2.117.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1"
  }
}
